# ---------------------------------------------------------------------------
# Claude Office Agents -> Notion.  Copy to .env for local runs; on Vercel paste
# each line as a separate Environment Variable.  Never commit the filled file.
#
# This set covers the Office Agents webhook only: the OTLP receiver plus the
# cron job that writes queued events into Notion.  Nothing here needs a Claude
# Enterprise plan or a Compliance Access Key.
# ---------------------------------------------------------------------------

# --- Required: the webhook ---------------------------------------------------
# Must be at least 32 bytes; the service refuses to start otherwise.
#   openssl rand -base64 32
OTLP_SHARED_SECRET=REPLACE_ME_32_BYTE_SECRET

# Guards /api/cron/*.  Vercel sends it automatically as a Bearer token.
#   openssl rand -base64 32
CRON_SECRET=REPLACE_ME_32_BYTE_SECRET

# --- Required: state store ---------------------------------------------------
# Vercel has no persistent disk. Postgres is mandatory there: without it the
# event index is lost on every cold start and Notion rows duplicate.
# Use the POOLED connection string (Neon pooler / PgBouncer).
# Takes precedence over STATE_DB_PATH whenever both are set.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# On a host WITH a persistent disk (Render, Fly, Railway, a VPS), delete
# DATABASE_URL above and use this instead:
# STATE_DB_PATH=/var/lib/claude-monitor/state.db

# --- Required: Notion --------------------------------------------------------
NOTION_TOKEN=REPLACE_ME_ROTATED_NOTION_TOKEN

# Agent Activity is the only database the Office Agents path writes to.
NOTION_DS_ACTIVITY=0ab146cc-1e96-4ae4-bc79-e192d74e4e77

# --- Optional: tuning --------------------------------------------------------
# Office add-ins run in a browser sandbox, so the collector must answer the CORS
# preflight or telemetry is dropped with no error shown in the admin console.
# Comma-separated; leave blank until you see the real origin in your logs.
OTLP_ALLOWED_ORIGINS=

OTLP_MAX_BODY_BYTES=4194304
NOTION_RATE_LIMIT_RPS=2.5
REDACTION_ENABLED=true

# ---------------------------------------------------------------------------
# ONLY needed if you later enable claude.ai chat-text sync (Enterprise plan +
# Compliance Access Key).  Leave these out for the Office Agents webhook: the
# four extra cron jobs are not scheduled in vercel.json, and Config.from_env()
# rejects a partial set anyway.
# ---------------------------------------------------------------------------
# ANTHROPIC_COMPLIANCE_ACCESS_KEY=
# NOTION_DS_MEMBERS=f5450280-c19a-4c90-ba5b-32828602cc9d
# NOTION_DS_PROJECTS=cb35713a-748d-42a8-80c5-7a702944e1be
# NOTION_DS_SYNC_RUNS=9e1aed68-a507-4aae-b354-684e83e7e016
# NOTION_DS_CONVERSATIONS=6f87f1db-8fb4-43b9-9010-1201bb3cc77a
# NOTION_PARENT_PAGE_ID=3aa1315e-db52-81a5-b2e5-d4ee6a43c66f
# PRODUCTION_READINESS=employee-notice:complete,lawful-basis:complete,access-approval:complete
# MIRROR_TRANSCRIPTS=true
# DOWNLOAD_ATTACHMENTS=false
