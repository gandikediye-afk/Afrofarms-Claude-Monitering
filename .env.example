# Claude Office Agents -> Notion webhook. Three variables, no database.

# The token you paste into Claude's "OTLP headers" box.
#   openssl rand -base64 32
OTLP_SHARED_SECRET=REPLACE_ME_32_BYTE_SECRET

# Your Notion integration token, shared with the Agent Activity database.
NOTION_TOKEN=REPLACE_ME_NOTION_TOKEN

# The Agent Activity data source id.
NOTION_DS_ACTIVITY=0ab146cc-1e96-4ae4-bc79-e192d74e4e77

# --- optional ---
# Office add-ins run in a browser, so the collector must answer the CORS
# preflight or telemetry is dropped with no error shown in the admin console.
OTLP_ALLOWED_ORIGINS=
OTLP_MAX_BODY_BYTES=4194304
# Set to false to skip the per-event "already in Notion?" lookup.
DEDUPE=true
